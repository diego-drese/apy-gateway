# Fase 11 — copie para .env na raiz do repo e rode ./scripts/install.sh
# (que gera APP_KEY sozinho se ficar vazio abaixo — nunca commite uma chave fixa).
#
# Só as variáveis que examples/docker-compose.yml realmente lê ficam aqui — o resto (URLs internas
# de MySQL/Redis/MinIO/Mailpit, nomes de serviço) já está fixo no compose porque não faz sentido
# configurar quando o ambiente inteiro é local.

APP_KEY=

DB_DATABASE=apy_gateway
DB_USERNAME=root
DB_PASSWORD=root

MINIO_BUCKET=apy-gateway-certs
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# SPEC.md §11 — deixe o default (Let's Encrypt de produção) só se for testar emissão de verdade
# contra um domínio público de verdade. Pra testar ACME localmente sem depender de DNS público,
# use o harness dedicado em docker/acme-verification/ (Pebble), não este ambiente de dev.
ACME_BASE_URL=https://acme-v02.api.letsencrypt.org

# Portas publicadas no host. Troque se alguma já estiver ocupada por outro projeto na sua máquina.
CONTROL_PLANE_HTTP_PORT=8000
MAILPIT_HTTP_PORT=8025
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=19001
AGENT_HTTP_PORT=8080
AGENT_HTTPS_PORT=8443
