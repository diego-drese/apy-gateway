# Variáveis de deploy da stack (não são segredos — segredos ficam em `docker secret`, ver
# create-secrets.sh). Copie para deploy/swarm/.env, ajuste e carregue antes do deploy:
#   set -a; . deploy/swarm/.env; set +a

# Versão publicada pelo CI (tag vX.Y.Z). Nunca `latest` em produção: o rollback precisa de uma
# versão anterior identificável.
APY_GATEWAY_VERSION=v0.2.0
REGISTRY=diegoneumann

# URL interna do painel (só pela VPN/rede administrativa — SPEC.md §6.0).
CONTROL_PLANE_URL=http://10.0.0.11:8000
CONTROL_PLANE_PORT=8000

# Rede overlay já existente que o NPM usa pra alcançar os apps (docker network ls --filter driver=overlay).
UPSTREAMS_NETWORK=proxy

# Durante a migração: 8080/8443 (NPM ainda em 80/443). No corte: 80/443.
EDGE_HTTP_PORT=8080
EDGE_HTTPS_PORT=8443

# SMTP — 2FA e aprovação de IP dependem de e-mail funcionando.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=apy-gateway@example.com
ADMIN_NOTIFICATION_EMAIL=infra@example.com

ACME_BASE_URL=https://acme-v02.api.letsencrypt.org
