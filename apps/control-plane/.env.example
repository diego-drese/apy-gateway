APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Redis, not the stock `database` driver — Fase 9's ACME issuance job is the first queue
# consumer in this app, and Redis is already required/running for the domain-events pub/sub.
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_NOTIFICATION_EMAIL=admin@example.com
IP_ACCESS_REQUEST_TTL_HOURS=24
TWO_FACTOR_CODE_TTL_MINUTES=5

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Same MinIO instance the Rust agent talks to (agent/src/config.rs uses the same var names).
MINIO_ENDPOINT_URL=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=apy-gateway-certs
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_FORCE_PATH_STYLE=true
MINIO_SSE_ENABLED=false

# SPEC.md §11: ACME (Let's Encrypt) automatic issuance. Point ACME_BASE_URL at Pebble
# (https://pebble:14000) for docker/acme-verification/ — never disable TLS verification to make
# that work, trust Pebble's test root via the container's system CA store instead.
ACME_BASE_URL=https://acme-v02.api.letsencrypt.org
ACME_ACCOUNT_KEY_STORAGE_PATH=acme/account-key.pem
ACME_RENEWAL_THRESHOLD_DAYS=30
ACME_CHALLENGE_PROPAGATION_DELAY_SECONDS=3
ACME_POLL_MAX_ATTEMPTS=10
ACME_POLL_INTERVAL_SECONDS=3

VITE_APP_NAME="${APP_NAME}"
